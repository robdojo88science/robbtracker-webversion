{
    "name":  "ftracker-shareable",
    "version":  "1.4.1",
    "private":  true,
    "main":  "expo-router/entry",
    "engines":  {
                    "node":  "\u003e=22.13.0"
                },
    "scripts":  {
                    "start":  "expo start --web",
                    "ios":  "expo run:ios",
                    "android":  "expo run:android",
                    "preview:windows":  "node scripts/preview-windows.mjs",
                    "typecheck":  "tsc --noEmit",
                    "test":  "tsx --test tests/*.test.ts",
                    "check":  "npm run typecheck \u0026\u0026 npm test",
                    "doctor":  "npx expo-doctor",
                    "build:ios:unsigned":  "node scripts/build-ios-unsigned.mjs",
                    "build:ios:development":  "npx --yes eas-cli@latest build --platform ios --profile development",
                    "build:ios:preview":  "npx --yes eas-cli@latest build --platform ios --profile preview",
                    "build:ios:production":  "npx --yes eas-cli@latest build --platform ios --profile production",
                    "submit:ios":  "npx --yes eas-cli@latest submit --platform ios --profile production",
                    "web":  "expo start --web",
                    "build:web":  "expo export --platform web --output-dir dist \u0026\u0026 node scripts/prepare-pwa.mjs",
                    "preview:web":  "node scripts/serve-pwa.mjs",
                    "build":  "npm run build:web \u0026\u0026 node scripts/bundle-worker.mjs",
                    "db:generate":  "drizzle-kit generate",
                    "start:native":  "expo start --dev-client"
                },
    "dependencies":  {
                         "@expo/vector-icons":  "^15.0.2",
                         "@noble/hashes":  "^2.0.1",
                         "drizzle-orm":  "^0.45.4",
                         "expo":  "~58.0.22",
                         "expo-asset":  "~58.0.19",
                         "expo-audio":  "~58.0.11",
                         "expo-blur":  "~58.0.5",
                         "expo-constants":  "~58.0.14",
                         "expo-crypto":  "~58.0.7",
                         "expo-dev-client":  "~58.0.18",
                         "expo-document-picker":  "~58.0.4",
                         "expo-file-system":  "~58.0.13",
                         "expo-font":  "~58.0.11",
                         "expo-haptics":  "~58.0.7",
                         "expo-image-manipulator":  "~58.0.16",
                         "expo-image-picker":  "~58.0.10",
                         "expo-linear-gradient":  "~58.0.3",
                         "expo-linking":  "~58.0.15",
                         "expo-notifications":  "~58.1.7",
                         "expo-router":  "~58.0.29",
                         "expo-secure-store":  "~58.0.2",
                         "expo-sharing":  "~58.0.21",
                         "expo-splash-screen":  "~58.0.12",
                         "expo-sqlite":  "~58.0.15",
                         "expo-status-bar":  "~58.0.4",
                         "expo-system-ui":  "~58.0.7",
                         "fast-xml-parser":  "^5.11.2",
                         "fflate":  "^0.8.3",
                         "react":  "19.3.0",
                         "react-dom":  "19.3.0",
                         "react-native":  "0.88.1",
                         "react-native-safe-area-context":  "~5.10.1",
                         "react-native-screens":  "~4.30.1",
                         "react-native-svg":  "15.16.0",
                         "react-native-web":  "^0.21.4",
                         "sql.js":  "^1.15.2"
                     },
    "devDependencies":  {
                            "@types/node":  "^24.10.0",
                            "@types/react":  "~19.3.0",
                            "@types/sql.js":  "^1.4.11",
                            "drizzle-kit":  "^0.31.11",
                            "esbuild":  "^0.28.2",
                            "expo-doctor":  "^1.21.5",
                            "fake-indexeddb":  "^6.2.7",
                            "tsx":  "^4.20.6",
                            "typescript":  "~6.0.3"
                        }
}
